{
  "name": "@financy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e:run": "node src/tests/e2e/run-e2e.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:infra:up": "docker compose --env-file src/tests/e2e/.env.e2e --file src/tests/e2e/compose.e2e.yaml --project-name financy-web-e2e up --detach --wait",
    "test:e2e:infra:down": "docker compose --env-file src/tests/e2e/.env.e2e --file src/tests/e2e/compose.e2e.yaml --project-name financy-web-e2e down --volumes --remove-orphans",
    "test:e2e:migrate": "set -a && . src/tests/e2e/.env.e2e && set +a && pnpm --filter @financy/api exec prisma migrate deploy",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@financy/contracts": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
